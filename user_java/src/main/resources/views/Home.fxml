<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="660.0" prefWidth="1024.0" style="-fx-background-color: #E3EDF9;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clinicom.user.controllers.HomeController">
    <top>
        <AnchorPane prefHeight="71.0" prefWidth="1024.0" style="-fx-background-color: #20c997;">
            <children>
                <Button fx:id="dashboardButton"
                        layoutX="1050.0"
                        layoutY="65.0"
                        style="-fx-background-color: #FFC20E; -fx-text-fill: #253D90; -fx-font-weight: bold;"
                        text="Dashboard"
                        onAction="#handleDashboard"
                        visible="false"/>

                <HBox alignment="CENTER_LEFT" layoutX="888.0" layoutY="49.0" prefHeight="56.0" prefWidth="112.0" spacing="10" style="-fx-background-color: #FFC20E; -fx-background-radius: 30; -fx-padding: 5px;">
                    <children>
                        <ImageView fitHeight="33.0" fitWidth="33.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../img/user_icon.png" />
                            </image>
                        </ImageView>
                        <Button fx:id="profileButton" onAction="#handleProfile" text="Profil" />
                    </children>
                </HBox>
                <ImageView fitHeight="148.0" fitWidth="467.0" layoutX="5.0" layoutY="5.0">
                    <image>
                        <Image url="@../img/logo_clinicom2.png" />
                    </image>
                </ImageView>
                <Label fx:id="welcomeLabel" layoutX="550" layoutY="60" style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;" />
            </children>
        </AnchorPane>
    </top>
     <left>
         <AnchorPane prefWidth="200.0" style="-fx-background-color: #20c997;">
             <children>
                 <VBox alignment="TOP_CENTER" layoutY="141.0" prefHeight="546.0" prefWidth="250.0" spacing="15" style="-fx-background-color: #20c997; -fx-background-radius: 10; -fx-padding: 20px;">
                     <children>
                         <Button style="-fx-background-color: #FFFFFF; -fx-text-fill: #253D90; -fx-background-radius: 15; -fx-font-size: 16px; -fx-font-weight: bold;" text="Gestion des evenements" />
                         <Button style="-fx-background-color: #FFFFFF; -fx-text-fill: #253D90; -fx-background-radius: 15; -fx-font-size: 16px; -fx-font-weight: bold;" text="Gestion des Dons" />
                         <Button style="-fx-background-color: #FFFFFF; -fx-text-fill: #253D90; -fx-background-radius: 15; -fx-font-size: 16px; -fx-font-weight: bold;" text="Gestion des Rendez-vous" />
                         <Button style="-fx-background-color: #FFFFFF; -fx-text-fill: #253D90; -fx-background-radius: 15; -fx-font-size: 16px; -fx-font-weight: bold;" text="Gestion du Réhabilation" />
                         <Button fx:id="btnLogout" alignment="BOTTOM_LEFT" onAction="#handleLogout" style="-fx-background-color: #D9534F; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 16px; -fx-font-weight: bold;" text="Déconnexion" />
                     </children>
                 </VBox>
                   <Button layoutX="49.0" layoutY="108.0" prefHeight="37.0" prefWidth="160.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #253D90; -fx-background-radius: 15; -fx-font-size: 16px; -fx-font-weight: bold;" text="Gestion des Blogs" />
             </children>
         </AnchorPane>
     </left>
     <center>
         <StackPane fx:id="contentArea" prefHeight="688.0" prefWidth="901.0" style="-fx-background-color: #FFFFF; -fx-background-radius: 10; -fx-padding: 10px;" />
     </center>
 </BorderPane>
