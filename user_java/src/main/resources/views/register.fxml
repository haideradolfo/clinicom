<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clinicom.user.controllers.RegisterController"
      spacing="20"
      alignment="CENTER"
      style="-fx-background-color: #f5f5f5; -fx-padding: 40;">

    <!-- VBox de gauche (logo) -->
    <VBox alignment="CENTER" spacing="20" prefWidth="300">
        <ImageView fitWidth="400" fitHeight="550">
            <Image url="@../img/register_img2.png"/>
        </ImageView>
    </VBox>

    <!-- VBox de droite (formulaire) -->
    <VBox alignment="CENTER" spacing="10" prefWidth="400"
          style="-fx-background-color: white; -fx-padding: 30; -fx-border-radius: 10; -fx-background-radius: 10;">

        <Label text="Inscription" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>

            <!-- Ligne 1 -->
            <children>
                <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Ligne 2 -->
                <Label text="Prénom:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="prenomField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Ligne 3 -->
                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" promptText="Ex: jean.dupont@mail.com" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Ligne 4 -->
                <Label text="Mot de passe:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField" promptText="8+ caractères avec majuscule/chiffre/symbole" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Ligne 5 -->
                <Label text="Confirmer MDP:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Ligne 6 -->
                <Label text="Rôle:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ComboBox fx:id="roleComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <!-- Ligne 7 - Spécialité -->
                <Label text="Spécialité:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="specialiteField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <!-- Ligne 8 - Téléphone -->
                <Label text="Téléphone:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <TextField fx:id="phoneField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <!-- Ligne 9 - Ville (corrigé) -->
                <Label text="Ville:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <ComboBox fx:id="villeCombo"
                          promptText="Sélectionnez votre ville"
                          GridPane.rowIndex="8"
                          GridPane.columnIndex="1"
                          prefWidth="200"/>

                <!-- Ligne 10 - Adresse -->
                <Label text="Adresse:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                <TextField fx:id="adresseField" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                <!-- Ligne 11 - Date de naissance -->
                <Label text="Date de naissance:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dateNaissanceField" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
            </children>
        </GridPane>

        <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
        <Button text="S'inscrire"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                onAction="#handleRegister"/>
        <Hyperlink text="Déjà un compte? Se connecter" onAction="#switchToLogin"/>
    </VBox>
</HBox>