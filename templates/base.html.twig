<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        
        {% block stylesheets %}
            

            <!-- Charger le bon fichier CSS selon la page -->
            {% if app.request.attributes.get('_route') == 'signin' %}
                <link rel="stylesheet" href="{{ asset('Login/css/signin.css') }}"> <!-- Fichier de style spécifique -->
            {% elseif app.request.attributes.get('_route') == 'signup' %}
                <link rel="stylesheet" href="{{ asset('Login/css/signup.css') }}">
                {% elseif app.request.attributes.get('_route') == 'backoffice' %}
            <link rel="stylesheet" href="{{ asset('Backoffice/backoffice.css') }}">
            {% endif %}
        {% endblock %}
    </head>

    <body>
        {% block body %}{% endblock %}

        {% block javascripts %}
            

            <script src="{{ asset('Login/js/plugins.js') }}"></script>
        {% endblock %}
    </body>
</html>
