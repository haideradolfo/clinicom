                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="mdi mdi-cog-outline me-2"></i> Paramètres
                        </a>
                        <div class="dropdown-divider my-2"></div>
                        <a href="{{ path('app_logout') }}" class="dropdown-item text-danger">
                            <i class="mdi mdi-logout-variant me-2"></i> Déconnexion
                        </a>
                    </div>
                </div>
            </li>
            {% endif %}
        </ul>
    </div>
</div>
                            
<div class="contact-section d-flex align-items-center">
