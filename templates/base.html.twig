                    </a>
                </div>
                <div class="col-lg-9 address-info text-right" style="position: relative; z-index: 9999;">
    <style>
        /* Reset du contexte d'empilement */
        .slider-section {
            position: relative;
            z-index: 100 !important;
        }

        .user-profile-container {
            position: static !important;
        }

        .dropdown-menu-custom {
            z-index: 10001 !important;
            position: absolute !important;
            top: calc(100% + 5px) !important;
            right: 15px !important;
            transform: none !important;
            margin: 0 !important;
            border: 1px solid rgba(0,0,0,0.15);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        /* Contournement des contextes d'empilement */
        .dropdown-parent {
            position: relative !important;
            z-index: 9999 !important;
            isolation: isolate;
        }
    </style>

    <div class="info box user-profile-container">
        <ul class="d-flex align-items-center list-unstyled mb-0" style="gap: 20px;">
            <!-- Email -->
            <li>
                <div class="icon">
                    <i class="flaticon-email"></i>
                </div>
                <div class="info">
                    <span>Email</span> Clinicom@gmail.com
                </div>
            </li>
            
            <!-- Téléphone -->
            <li>
                <div class="icon">
                    <i class="flaticon-call"></i>
                </div>
                <div class="info">
                    <span>Phone</span> +123 456 7890
                </div>
            </li>
            
            <!-- Profil Utilisateur -->
            {% if app.user %}
            <li class="dropdown-parent">
                <div class="dropdown">
                    <button type="button" 
                            class="btn header-item bg-light border rounded-pill p-2 d-flex align-items-center" 
                            id="front-user-dropdown"
                            data-bs-toggle="dropdown" 
                            aria-expanded="false">
                        <img src="{{ asset('Back/assets/images/utilisateur.jpg') }}" 
                             class="rounded-circle" 
                             alt="Avatar"
                             style="width: 32px; height: 32px; object-fit: cover;">
                        <span class="ms-2 d-none d-md-inline-block text-dark fw-medium">
                            {{ app.user.prenom }} {{ app.user.nom }}
                        </span>
                        <i class="mdi mdi-chevron-down ms-1 align-middle"></i>
                    </button>
                    
                    <div class="dropdown-menu dropdown-menu-custom shadow" 
                         aria-labelledby="front-user-dropdown"
                         style="min-width: 200px;">
                        <div class="px-3 py-2">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <img src="{{ asset('Back/assets/images/utilisateur.jpg') }}" 
                                         class="rounded-circle"
                                         width="40"
                                         alt="Avatar">
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-0">{{ app.user.prenom }} {{ app.user.nom }}</h6>
                                    <small class="text-muted">{{ app.user.email }}</small>
                                </div>
                            </div>
                        </div>
                        <div class="dropdown-divider my-2"></div>
                        <a href="{{ path('front_profile_index') }}" class="dropdown-item">
