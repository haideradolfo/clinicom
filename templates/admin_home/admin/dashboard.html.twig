{% extends 'baseAdmin.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
    <h1>Bienvenue, Admin</h1>

    <h2>Table des utilisateurs</h2>

    <!-- Formulaire de recherche -->
    <form method="get" action="{{ path('admin_dashboard') }}" id="search-form">
        <input type="text" name="q" id="search-input" placeholder="Rechercher un utilisateur..." value="{{ app.request.get('q') }}">
    </form>

    <!-- Table dynamique -->
    <div id="users-table">
        {% include 'admin_home/admin/_user_table.html.twig' %}
    </div>

    <script>
        document.getElementById('search-input').addEventListener('keyup', function() {
            let query = this.value;
            fetch("{{ path('admin_dashboard') }}?q=" + encodeURIComponent(query), { 
                headers: { 'X-Requested-With': 'XMLHttpRequest' } 
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('users-table').innerHTML = html;
            });
        });
    </script>
{% endblock %}
