{% extends 'base.html.twig' %}

{% block title %}Clinicom Admin Dashboard{% endblock %}

{% block body %}
    <header class="admin-header">
        <div class="header-content">
            <div class="logo">
                <img src="{{ asset('Backoffice/images/logo_sec.png') }}" alt="Logo" class="logo-image">
                <h1>Clinicom</h1>
            </div>
            <nav class="header-actions">
                <a href="{{ path('signin') }}" class="logout-btn">Déconnexion</a>
            </nav>
        </div>
    </header>

    <div class="dashboard-container">
<aside class="sidebar">
    <nav class="sidebar-nav">
        <ul>
            <li class="{{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' }}">
                <a href="{{ path('admin_dashboard') }}">
                    <i class="fas fa-home"></i> Dashboard
                </a>
            </li>
            <li class="{{ app.request.attributes.get('_route') == 'admin_users' ? 'active' }}">
                <a href="{{ path('admin_users') }}">
                    <i class="fas fa-users"></i> Utilisateurs
                </a>
            </li>
                    <li><a href="#"><i class="fas fa-box"></i> Rehabilitations</a></li>
                    <li><a href="#"><i class="fas fa-chart-bar"></i> Statistiques</a></li>
                    <li><a href="#"><i class="fas fa-cog"></i> Paramètres</a></li>
                </ul>
            </nav>
        </aside>

        <main class="main-content">
            <div class="content-header">
                <h2>{{ block('page_title') }}</h2>
                <div class="breadcrumb">
                    Accueil / {{ block('page_title') }}
                </div>
            </div>
            
            {% if app.request.attributes.get('_route') == 'admin_dashboard' %}
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3>Utilisateurs</h3>
                        <p>1,234</p>
                        <i class="fas fa-users stat-icon"></i>
                    </div>
                    <div class="stat-card">
                        <h3>Commandes</h3>
                        <p>89</p>
                        <i class="fas fa-shopping-cart stat-icon"></i>
                    </div>
                    <div class="stat-card">
                        <h3>Revenu</h3>
                        <p>€12,540</p>
                        <i class="fas fa-euro-sign stat-icon"></i>
                    </div>
                </div>
            {% endif %}
        </main>
    </div>
{% endblock %}

{% block page_title %}
    {% if app.request.attributes.get('_route') == 'admin_dashboard' %}
        Tableau de bord
    {% elseif app.request.attributes.get('_route') == 'admin_users' %}
        Gestion des Utilisateurs
    {% endif %}
{% endblock %}