{% extends 'base.html.twig' %}

{% block title %}Sign In{% endblock %}

{% block body %}
<img src="{{ asset('Login/images/logo_clinicom.png') }}" alt="Logo" class="logo">
<div class="container">
    <form class="form" method="POST">
        <p class="title">Sign In</p>
        <p class="message">Welcome back! Please login to your account.</p>

        <label>
            <input type="email" class="input" placeholder=" " required>
            <span>Email</span>
        </label>

        <label>
            <input type="password" class="input" placeholder=" " required>
            <span>Password</span>
        </label>

        <button type="submit" class="submit">Login</button>
        
        <p class="signin">Don't have an account? 
            <a href="{{ path('signup') }}">Register here</a>
        </p>
    </form>
</div>
{% endblock %}