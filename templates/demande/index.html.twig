{% extends 'baseAdmin.html.twig' %}

{% block title %}Gestion des Demandes{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="card-title"><i class="fas fa-list"></i> Liste des Demandes</h3>
            <a href="{{ path('app_demande_new') }}" class="btn btn-success"><i class="fas fa-plus"></i> Ajouter une Demande</a>
        </div>

        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>ID Demande</th>
                        <th>Description Demande</th>
                        <th>Montant Demande</th>
                        <th>Type Demande</th>
                        <th>Photo Demande</th>
                        <th>Créé le</th>
                        <th>Modifié le</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for demande in demandes %}
                    <tr>
                        <td>{{ demande.id }}</td>
                        <td>{{ demande.descriptionDemande }}</td>
                        <td>{{ demande.montantDemande }} €</td>
                        <td>{{ demande.typeSongDemader }}</td>
                        <td>
                            {% if demande.photoDemande %}
                                <img src="{{ asset('uploads/' ~ demande.photoDemande) }}" alt="Photo" width="50" class="img-thumbnail">
                            {% else %}
                                <span class="badge bg-secondary">Pas d'image</span>
                            {% endif %}
                        </td>
                        <td>{{ demande.CreatedAt ? demande.CreatedAt|date('d/m/Y H:i') : 'N/A' }}</td>
                        <td>{{ demande.UpdatedAt ? demande.UpdatedAt|date('d/m/Y H:i') : 'N/A' }}</td>
                        <td>
                            <a href="{{ path('app_demande_show', {'id': demande.id}) }}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i> Voir</a>
                            <a href="{{ path('app_demande_edit', {'id': demande.id}) }}" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Modifier</a>
                            <form method="post" action="{{ path('app_demande_delete', {'id': demande.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ demande.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center">Aucune demande trouvée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
