{% extends 'base.html.twig' %}

{% block title %}Donation{% endblock %}

{% block body %}
    <h1>Donation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ donation.id }}</td>
            </tr>
            <tr>
                <th>DescriptionDonation</th>
                <td>{{ donation.descriptionDonation }}</td>
            </tr>
            <tr>
                <th>MontantDonation</th>
                <td>{{ donation.montantDonation }}</td>
            </tr>
            <tr>
                <th>TypeSong</th>
                <td>{{ donation.typeSong }}</td>
            </tr>
            <tr>
                <th>PhotoDonation</th>
                <td>{{ donation.photoDonation }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ donation.createdAt ? donation.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ donation.updatedAt ? donation.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_donation_index') }}">back to list</a>

    <a href="{{ path('app_donation_edit', {'id': donation.id}) }}">edit</a>

    {{ include('donation/_delete_form.html.twig') }}
{% endblock %}
