{% extends 'base.html.twig' %}

{% block title %}Historique des Dons{% endblock %}

{% block body %}
    <!-- Historique des Dons -->
    <div class="donation-history-area default-padding">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="site-heading text-center">
                        <h4>Historique de mes Donations</h4>
                        <p>Voici l'historique complet de vos dons passés. Vous pouvez consulter les détails de chaque don et les gérer.</p>
                    </div>
                </div>
            </div>

            <!-- Table des Dons -->
            <div class="row">
                <div class="col-lg-12">
                    <div class="table-responsive">
                        <!-- Ajouter le bouton ici -->
                        <div class="text-right mb-3">
                            <a href="{{ path('app_donation_new') }}" class="btn btn-success">
                                <i class="fas fa-plus"></i> Créer un nouveau don
                            </a>
                        </div>

                        <table class="table table-bordered table-hover border-top border-primary">
                            <thead style="background-color: #4AC6C5;" class="text-white text-center">
                                <tr>
                                    <th>ID</th>
                                    <th>Description</th>
                                    <th>Montant</th>
                                    <th>Type de Donation</th>
                                    <th>Type de Sang</th>
                                    <th>Photo</th>
                                    <th>Date de création</th>
                                    <th>Dernière modification</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for donation in donations %}
                                    <tr>
                                        <td class="text-center">{{ donation.id }}</td>
                                        <td>{{ donation.descriptionDonation }}</td>
                                        <td>{{ donation.montantDonation }} €</td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">{{ donation.typeSang }}</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-danger">{{ donation.typeSang }}</span>
                                        </td>
                                        <td class="text-center">
                                            {% if donation.photoDonation %}
                                                <img src="{{ asset(donation.photoDonation) }}" alt="Photo du don" class="img-thumbnail" width="50">
                                            {% else %}
                                                Aucune photo
                                            {% endif %}
                                        </td>
                                        <td class="text-center">{{ donation.createdAt ? donation.createdAt|date('Y-m-d H:i:s') : 'Non défini' }}</td>
                                        <td class="text-center">{{ donation.updatedAt ? donation.updatedAt|date('Y-m-d H:i:s') : 'Non modifié' }}</td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a href="{{ path('app_donation_show', {'id': donation.id}) }}" class="btn btn-outline-info btn-sm" title="Voir">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="{{ path('app_donation_edit', {'id': donation.id}) }}" class="btn btn-outline-warning btn-sm" title="Modifier">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <!-- Formulaire de suppression sécurisé -->
                                                <form method="post" action="{{ path('app_donation_delete', {'id': donation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce don ?');" style="display:inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ donation.id) }}">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center">Aucun don trouvé</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
