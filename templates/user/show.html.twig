{% extends 'base.html.twig' %}

{% block title %}Détails de l'Utilisateur{% endblock %}

{% block body %}
    <h1>Détails de l'Utilisateur</h1>

    <ul>
        <li><strong>Nom :</strong> {{ user.nom }}</li>
        <li><strong>Prénom :</strong> {{ user.prenom }}</li>
        <li><strong>Email :</strong> {{ user.email }}</li>
        <li><strong>Rôle :</strong> {{ user.role }}</li>
        <li><strong>Ville :</strong> {{ user.ville }}</li>
    </ul>

    <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-warning">Modifier</a>
    <a href="{{ path('user_index') }}" class="btn btn-secondary">Retour</a>
{% endblock %}
