{% extends 'base.html.twig' %}

{% block title %}Clinicom - Acceuil{% endblock %}
{% block body %}
<body>
    
    
    <!-- Start Banner 
    ============================================= -->
    <div class="banner-area">
        <div id="bootcarousel" class="carousel responsive-top-pad-110p text-large slide carousel-fade animate_text" data-ride="carousel">

            <!-- Wrapper for slides -->
            <div class="carousel-inner carousel-zoom">
                <div class="carousel-item active">
                    <div class="slider-thumb bg-cover" style="background-image: url(Front/assets/img/banner/1.jpg);"></div>
                    <div class="box-table">
                        <div class="box-cell">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-9">
                                        <div class="content">
                                            <h2 data-animation="animated slideInDown"> ton docteur   <strong>virtuelle</strong></h2>
                                            <p  data-animation="animated slideInLeft">
                                              Clinicom  est une application de santé connectée personnalisée qui facilite le suivi des symptômes, l’interaction entre patients et médecins, et la gestion sécurisée des utilisateurs, tout en offrant des recommandations basées sur l’intelligence artificielle pour améliorer la prise en charge médicale.
 
                                            </p>
                                            <a data-animation="animated fadeInUp" class="btn btn-md btn-gradient" href="#">Introduire les symptômes</a>
                                            <a data-animation="animated fadeInDown" class="btn btn-md btn-light effect" href="#">Chercher médecin <i class="fas fa-angle-right"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="slider-thumb bg-cover" style="background-image: url(Front/assets/img/banner/5.jpg);"></div>
                    <div class="box-table">
                        <div class="box-cell">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-9">
                                        <div class="content">
                                            <h2 data-animation="animated slideInDown">ton docteur  <strong>virtuelle</strong></h2>
                                            <p  data-animation="animated slideInLeft">
                                               Clinicom est une application de santé connectée personnalisée qui facilite le suivi des symptômes, l’interaction entre patients et médecins, et la gestion sécurisée des utilisateurs, tout en offrant des recommandations basées sur l’intelligence artificielle pour améliorer la prise en charge médicale.
                                            </p>
                                            <a data-animation="animated fadeInUp" class="btn btn-md btn-gradient" href="#">Introduire les symptômes</a>
                                            <a data-animation="animated fadeInDown" class="btn btn-md btn-light effect" href="#">Chercher médecin <i class="fas fa-angle-right"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- End Wrapper for slides -->

            <!-- Left and right controls -->
            <a class="left carousel-control" href="#bootcarousel" data-slide="prev">
                <i class="fa fa-angle-left"></i>
                <span class="sr-only">Previous</span>
            </a>
            <a class="right carousel-control" href="#bootcarousel" data-slide="next">
                <i class="fa fa-angle-right"></i>
                <span class="sr-only">Next</span>
            </a>

        </div>
    </div>
    <!-- End Banner -->



</body>
{% endblock %}